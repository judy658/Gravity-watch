import yt_dlp
import json
import requests
import os
import random
import re
from dotenv import load_dotenv

load_dotenv()

def is_music(title, uploader):
    music_keywords = [
        'official video', 'official audio', 'lyric video', 'official music video',
        'şarkısı', 'müzik', 'klibi', 'song', 'music video', 'lyrics', 'ft.', 'feat',
        'prod.', 'remix', 'mix', 'mashup'
    ]
    full_text = (title + " " + (uploader or "")).lower()
    for word in music_keywords:
        if word in full_text:
            return True
    return False

def get_home_feed(access_token=None, interest_data=None, subscriptions=None, page=1, external_seen_ids=None):
    final_results = []
    seen_ids = set(external_seen_ids or [])
    
    print(f"--- FEED ENGINE ACTIVE (Page: {page}) ---")
    
    ydl_opts = {
        'quiet': True, 
        'extract_flat': True, 
        'max_downloads': 1,
        'extractor_args': {'youtube': {'player_client': ['web'], 'lang': ['tr']}}, 
        'geo_bypass': True,
        'geo_bypass_country': 'TR',
        'no_warnings': True
    }
    
    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        # 1. KATMAN: Abonelikler (%40)
        if subscriptions:
            sub_list = list(subscriptions)
            random.shuffle(sub_list)
            offset = (page - 1) * 3
            for channel in sub_list[:5]:
                try:
                    limit = offset + 5
                    info = ydl.extract_info(f"ytsearch{limit}:{channel}", download=False)
                    entries = info.get('entries', [])[offset:offset+3]
                    for e in entries:
                        if e['id'] not in seen_ids and not is_music(e['title'], e.get('uploader')):
                            final_results.append({
                                'id': e['id'], 'title': e['title'],
                                'thumbnail': f"https://i.ytimg.com/vi/{e['id']}/hqdefault.jpg",
                                'uploader': e.get('uploader', channel),
                                'label': 'SUBSCRIPTION'
                            })
                            seen_ids.add(e['id'])
                except: pass

        # 2. KATMAN: Kisisel Match (%30)
        if interest_data:
            offset = (page - 1) * 2
            sorted_interests = sorted(interest_data.items(), key=lambda x: x[1], reverse=True)
            for tag, score in sorted_interests[:5]:
                try:
                    limit = offset + 5
                    info = ydl.extract_info(f"ytsearch{limit}:{tag}", download=False)
                    entries = info.get('entries', [])[offset:offset+3]
                    for e in entries:
                        if e['id'] not in seen_ids and not is_music(e['title'], e.get('uploader')):
                            final_results.append({
                                'id': e['id'], 'title': e['title'],
                                'thumbnail': f"https://i.ytimg.com/vi/{e['id']}/hqdefault.jpg",
                                'uploader': e.get('uploader', 'YouTube'),
                                'label': f'{tag.upper()} MATCH'
                            })
                            seen_ids.add(e['id'])
                except: pass

        # 3. KATMAN: Benzer İçerik (%20)
        sim_query = "türkçe popüler videolar"
        if interest_data:
            sim_query = list(interest_data.keys())[0] + " gamer"
        try:
            info = ydl.extract_info(f"ytsearch{page*5 + 5}:{sim_query}", download=False)
            entries = info.get('entries', [])[page*3 : page*3 + 6]
            for e in entries:
                if e['id'] not in seen_ids and not is_music(e['title'], e.get('uploader')):
                    final_results.append({
                        'id': e['id'], 'title': e['title'],
                        'thumbnail': f"https://i.ytimg.com/vi/{e['id']}/hqdefault.jpg",
                        'uploader': e.get('uploader', 'YouTube'),
                        'label': 'SIMILAR'
                    })
                    seen_ids.add(e['id'])
        except: pass

        # 4. KATMAN: Yerel Trendler (TR) (%10)
        tr_topics = ['türkiye trend', 'türkçe teknoloji', 'türkçe oyun']
        disco_query = tr_topics[page % len(tr_topics)]
        try:
            info = ydl.extract_info(f"ytsearch10:{disco_query}", download=False)
            for e in info.get('entries', [])[:3]:
                if e['id'] not in seen_ids and not is_music(e['title'], e.get('uploader')):
                    final_results.append({
                        'id': e['id'], 'title': e['title'],
                        'thumbnail': f"https://i.ytimg.com/vi/{e['id']}/hqdefault.jpg",
                        'uploader': e.get('uploader', 'YouTube'),
                        'label': 'TR KEŞFET'
                    })
                    seen_ids.add(e['id'])
        except: pass

    # Fallback
    if len(final_results) < 3:
        try:
            info = ydl.extract_info("ytsearch10:popüler videolar", download=False)
            for e in info.get('entries', []):
                final_results.append({
                    'id': e['id'], 'title': e['title'],
                    'thumbnail': f"https://i.ytimg.com/vi/{e['id']}/hqdefault.jpg",
                    'uploader': e.get('uploader', 'YouTube'),
                    'label': 'TREND'
                })
        except: pass

    random.shuffle(final_results)
    return final_results

def search_videos(query):
    ydl_opts = {'quiet': True, 'extract_flat': True, 'extractor_args': {'youtube': {'lang': ['tr']}}}
    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        try:
            info = ydl.extract_info(f"ytsearch25:{query}", download=False)
            return [{'id': e['id'], 'title': e['title'], 'thumbnail': f"https://i.ytimg.com/vi/{e['id']}/hqdefault.jpg", 'uploader': e.get('uploader', 'YouTube')} for e in info.get('entries', [])]
        except: return []

def get_video_info(url_or_id):
    """EN STABIL MOD: 360P/720P ODAKLI."""
    if not url_or_id.startswith('http'):
        url_or_id = f"https://www.youtube.com/watch?v={url_or_id}"
    
    ydl_opts = {
        'format': 'best',
        'quiet': True,
        'skip_download': True,
        'no_warnings': True,
        'geo_bypass': True
    }
    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        try:
            info = ydl.extract_info(url_or_id, download=False)
            # Sadece tek parca (progressive) olanlari al
            qualities = {}
            for f in info.get('formats', []):
                if f.get('vcodec') != 'none' and f.get('acodec') != 'none':
                    h = f.get('height')
                    if h: qualities[f"{h}p"] = f.get('url')

            return {
                'id': info.get('id'), 'title': info.get('title'),
                'thumbnail': info.get('thumbnail'), 'description': info.get('description'),
                'uploader': info.get('uploader'), 'view_count': info.get('view_count', 0),
                'qualities': qualities,
                'best_url': info.get('url'),
                'dash_url': None # DASH riskini kapattik
            }
        except Exception:
            return {'error': "Video açılamıyor."}
